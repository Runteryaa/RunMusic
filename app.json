{
  "expo": {
    "name": "RunMusic",
    "slug": "RunMusic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "runmusic",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.runterya.music",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocalNetworkUsageDescription": "RunMusic, aynı Wi-Fi ağındaki diğer cihazlara bağlanarak müzik kontrolü sağlamak için yerel ağ izni ister.",
        "NSBluetoothAlwaysUsageDescription": "RunMusic, diğer cihazları uzaktan kumanda etmek için Bluetooth bağlantısı kullanır.",
        "NSBluetoothPeripheralUsageDescription": "RunMusic, diğer cihazları uzaktan kumanda etmek için Bluetooth bağlantısı kullanır.",
        "NSUserTrackingUsageDescription": "Size özel ve uygun reklam deneyimi sunabilmek için izniniz istenmektedir.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3163A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.runterya.music"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow RunMusic to access your media to find audio files.",
          "savePhotosPermission": "Allow RunMusic to save audio files.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["audio", "photo"]
        }
      ],
      "expo-sqlite",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458737195",
          "userTrackingUsageDescription": "Size özel ve uygun reklam deneyimi sunabilmek için izniniz istenmektedir."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "RunMusic diğer cihazları kontrol etmek ve bağlanmak için Bluetooth kullanır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dde6e67b-f99d-4604-ba3d-190bdf69d6c5"
      }
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/dde6e67b-f99d-4604-ba3d-190bdf69d6c5",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458737195"
  }
}
