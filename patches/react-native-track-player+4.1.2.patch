+package com.doublesymmetry.trackplayer.service
+
+import android.media.audiofx.Equalizer
+import android.media.audiofx.LoudnessEnhancer
+import com.doublesymmetry.kotlinaudio.players.QueuedAudioPlayer
+import com.google.android.exoplayer2.ExoPlayer
+import com.google.android.exoplayer2.Player
+import timber.log.Timber
+import java.lang.reflect.Modifier
+import kotlin.math.abs
+import kotlin.math.min
+import kotlin.math.pow
+
+/**
+ * RunMusic eklentisi: per-app (audio session) ekolayzer + ReplayGain.
+ *
+ * KotlinAudio'nun `exoPlayer` alanı `protected` olduğu için reflection ile
+ * erişilir. R8/minify kapalı olduğundan alan adı korunur. Audio session
+ * oluşturulduğunda ve her değiştiğinde efektler yeniden bağlanır.
+ *
+ * Ses seviyesi iki katmana ayrılır:
+ *  - `userVolume`: JS `TrackPlayer.setVolume` / uyku zamanlayıcısı
+ *  - `gainMultiplier`: ReplayGain + preamp zayıflatması
+ *
+ * Böylece uyku zamanlayıcısı `getVolume()` ile taban seviyeyi görür ve
+ * ReplayGain kazancını yanlışlıkla sıfırlamaz.
+ */
+class AudioEffectsManager(
+    private val audioPlayer: QueuedAudioPlayer
+) {
+    companion object {
+        private val FIXED_BAND_FREQUENCIES_HZ = intArrayOf(60, 230, 910, 3600, 14000)
+        private const val MIN_GAIN_DB = -24f
+        private const val MAX_GAIN_DB = 12f
+    }
+
+    private var exoPlayer: ExoPlayer? = null
+    private var playerListener: Player.Listener? = null
+    private var equalizer: Equalizer? = null
+    private var loudnessEnhancer: LoudnessEnhancer? = null
+    private var boundSessionId = 0
+
+    private var equalizerEnabled = false
+    private var bandGainsDb: List<Float> = List(FIXED_BAND_FREQUENCIES_HZ.size) { 0f }
+    private var preampDb = 0f
+    private var replayGainDb = 0f
+    private var userVolume = 1f
+
+    init {
+        bindPlayer()
+    }
+
+    /**
+     * JS köprüsünden gelen efekt ayarlarını uygular.
+     * Değerler zaten JS tarafında sınırlandırılır; yine de savunmacı davranılır.
+     */
+    fun setEffects(
+        enabled: Boolean,
+        bandGainsDb: List<Float>,
+        preampDb: Float,
+        replayGainDb: Float
+    ) {
+        this.equalizerEnabled = enabled
+        this.bandGainsDb = normalizeBands(bandGainsDb)
+        this.preampDb = clampGain(preampDb)
+        this.replayGainDb = clampGain(replayGainDb)
+        applyEqualizer()
+        applyGain()
+    }
+
+    /** JS `getVolume` / `setVolume` için taban kullanıcı sesi. */
+    fun setUserVolume(value: Float) {
+        userVolume = value.coerceIn(0f, 1f)
+        applyGain()
+    }
+
+    fun getUserVolume(): Float = userVolume
+
+    fun release() {
+        val listener = playerListener
+        val player = exoPlayer
+        if (listener != null && player != null) {
+            try {
+                player.removeListener(listener)
+            } catch (error: Throwable) {
+                Timber.w(error, "Failed to remove audio effects player listener")
+            }
+        }
+        playerListener = null
+        detachAudioEffects()
+        exoPlayer = null
+    }
+
+    private fun bindPlayer() {
+        val player = findExoPlayer(audioPlayer)
+        if (player == null) {
+            Timber.w("AudioEffectsManager could not find ExoPlayer; audio effects disabled")
+            return
+        }
+
+        exoPlayer = player
+        val listener = object : Player.Listener {
+            override fun onAudioSessionIdChanged(audioSessionId: Int) {
+                if (audioSessionId == boundSessionId) return
+                detachAudioEffects()
+                if (audioSessionId != 0) attachAudioEffects(audioSessionId)
+                applyGain()
+            }
+        }
+        playerListener = listener
+
+        try {
+            player.addListener(listener)
+        } catch (error: Throwable) {
+            Timber.w(error, "Failed to add audio effects player listener")
+        }
+
+        val sessionId = try {
+            player.audioSessionId
+        } catch (error: Throwable) {
+            0
+        }
+        if (sessionId != 0) attachAudioEffects(sessionId)
+    }
+
+    private fun attachAudioEffects(sessionId: Int) {
+        boundSessionId = sessionId
+
+        equalizer = try {
+            Equalizer(0, sessionId)
+        } catch (error: Throwable) {
+            Timber.w(error, "Failed to create Equalizer for session $sessionId")
+            null
+        }
+
+        loudnessEnhancer = try {
+            LoudnessEnhancer(sessionId)
+        } catch (error: Throwable) {
+            Timber.w(error, "Failed to create LoudnessEnhancer for session $sessionId")
+            null
+        }
+
+        applyEqualizer()
+        applyGain()
+    }
+
+    private fun detachAudioEffects() {
+        boundSessionId = 0
+
+        try {
+            equalizer?.enabled = false
+        } catch (_: Throwable) {
+        }
+        try {
+            equalizer?.release()
+        } catch (_: Throwable) {
+        }
+        equalizer = null
+
+        try {
+            loudnessEnhancer?.enabled = false
+        } catch (_: Throwable) {
+        }
+        try {
+            loudnessEnhancer?.release()
+        } catch (_: Throwable) {
+        }
+        loudnessEnhancer = null
+    }
+
+    private fun applyEqualizer() {
+        val effect = equalizer ?: return
+        try {
+            val deviceBandCount = effect.numberOfBands.toInt()
+            if (deviceBandCount <= 0) return
+
+            val levelRange = effect.bandLevelRange
+            val minLevelMb = levelRange[0].toInt()
+            val maxLevelMb = levelRange[1].toInt()
+
+            // Cihaz bantlarının merkez frekansları milliHertz cinsindendir.
+            val centerFrequenciesHz = IntArray(deviceBandCount) { index ->
+                effect.getCenterFreq(index.toShort()) / 1000
+            }
+
+            for (index in FIXED_BAND_FREQUENCIES_HZ.indices) {
+                val desiredHz = FIXED_BAND_FREQUENCIES_HZ[index]
+                var bestBand = 0
+                var bestDistance = Int.MAX_VALUE
+
+                for (band in 0 until deviceBandCount) {
+                    val distance = abs(centerFrequenciesHz[band] - desiredHz)
+                    if (distance < bestDistance) {
+                        bestDistance = distance
+                        bestBand = band
+                    }
+                }
+
+                val levelMb = (bandGainsDb[index] * 100f).toInt().coerceIn(minLevelMb, maxLevelMb)
+                effect.setBandLevel(bestBand.toShort(), levelMb.toShort())
+            }
+
+            effect.enabled = equalizerEnabled
+        } catch (error: Throwable) {
+            Timber.w(error, "Failed to apply equalizer settings")
+        }
+    }
+
+    private fun applyGain() {
+        val totalGainDb = clampGain(preampDb + replayGainDb)
+        val attenuationDb = min(0f, totalGainDb)
+        val multiplier = 10f.pow(attenuationDb / 20f)
+        val effectiveVolume = (userVolume * multiplier).coerceIn(0f, 1f)
+
+        try {
+            // KotlinAudio'nun `volume` setter'ı kendi audio-focus ducking
+            // çarpanını da uygular; bu yüzden ExoPlayer'a doğrudan yazmıyoruz.
+            audioPlayer.volume = effectiveVolume
+        } catch (error: Throwable) {
+            Timber.w(error, "Failed to set player volume")
+        }
+
+        val enhancer = loudnessEnhancer
+        if (enhancer != null) {
+            try {
+                if (totalGainDb > 0.01f) {
+                    // LoudnessEnhancer hedef kazancı milibel cinsindendir.
+                    enhancer.setTargetGain((totalGainDb * 100f).toInt())
+                    enhancer.enabled = true
+                } else {
+                    enhancer.enabled = false
+                }
+            } catch (error: Throwable) {
+                Timber.w(error, "Failed to apply LoudnessEnhancer gain")
+            }
+        }
+    }
+
+    private fun normalizeBands(input: List<Float>): List<Float> {
+        return List(FIXED_BAND_FREQUENCIES_HZ.size) { index ->
+            val value = input.getOrNull(index) ?: 0f
+            if (value.isFinite()) clampGain(value) else 0f
+        }
+    }
+
+    private fun clampGain(value: Float): Float {
+        if (!value.isFinite()) return 0f
+        return value.coerceIn(MIN_GAIN_DB, MAX_GAIN_DB)
+    }
+
+    private fun findExoPlayer(target: Any): ExoPlayer? {
+        var type: Class<*>? = target.javaClass
+        while (type != null && type != Any::class.java) {
+            for (field in type.declaredFields) {
+                if (Modifier.isStatic(field.modifiers)) continue
+                if (!Player::class.java.isAssignableFrom(field.type)) continue
+                try {
+                    field.isAccessible = true
+                    val value = field.get(target)
+                    if (value is ExoPlayer) return value
+                } catch (error: Throwable) {
+                    Timber.w(error, "Failed to read ExoPlayer field ${field.name}")
+                }
+            }
+            type = type.superclass
+        }
+        return null
+    }
+}
