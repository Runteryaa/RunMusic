<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    android:baselineAligned="false">

    <!-- Left: Artwork (will be rounded in Kotlin) -->
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="centerCrop" />

    <!-- Right: Texts & Controls -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:paddingStart="20dp">

        <!-- Top part: Texts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true"
            android:layout_marginTop="8dp">
            
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RunMusic"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Müzik Çalar"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Bottom part: Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical|start">

            <ImageButton
                android:id="@+id/widget_btn_shuffle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_shuffle"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_prev"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_btn_star"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_star"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>